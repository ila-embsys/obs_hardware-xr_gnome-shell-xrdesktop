+// macro to load an opengl function pointer with cogl_get_proc_address
+#define LOAD_GL_FUNC(TYPE, FUNC) \
+    _ ## FUNC = (TYPE) cogl_get_proc_address(#FUNC); \
+    if (_ ## FUNC == NULL) \
